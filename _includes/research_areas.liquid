<div class="research-grid">
  {% for area in page.research_areas %}
    <div class="research-card">
      {% if area.glyph %}
        <div class="research-icon" aria-hidden="true">
          {% case area.glyph %}
            {% when 'curl' %}
              <!-- 2-cell (pentagon) with a rotating curl arrow -->
              <svg class="glyph glyph-curl" viewBox="0 0 40 40">
                <polygon class="g-face" points="20,5 34,15 29,32 11,32 6,15" />
                <g class="g-spin">
                  <path class="g-line" d="M26 20A6 6 0 1 1 23.86 15.4" />
                  <polygon class="g-node" points="25.8,17 22.6,16.9 25.1,13.9" />
                </g>
                <circle class="g-node" cx="20" cy="5" r="2" />
                <circle class="g-node" cx="34" cy="15" r="2" />
                <circle class="g-node" cx="29" cy="32" r="2" />
                <circle class="g-node" cx="11" cy="32" r="2" />
                <circle class="g-node" cx="6" cy="15" r="2" />
              </svg>
            {% when 'edges' %}
              <!-- edges inferred one by one, then a 2-cell is filled -->
              <svg class="glyph glyph-edges" viewBox="0 0 40 40">
                <polygon class="g-face g-fill" points="18,8 33,13 30,32" />
                <line class="g-line g-draw d1" x1="8" y1="28" x2="18" y2="8" pathLength="1" />
                <line class="g-line g-draw d2" x1="18" y1="8" x2="33" y2="13" pathLength="1" />
                <line class="g-line g-draw d3" x1="33" y1="13" x2="30" y2="32" pathLength="1" />
                <line class="g-line g-draw d4" x1="30" y1="32" x2="18" y2="8" pathLength="1" />
                <line class="g-line g-draw d5" x1="30" y1="32" x2="8" y2="28" pathLength="1" />
                <circle class="g-node" cx="8" cy="28" r="2.2" />
                <circle class="g-node" cx="18" cy="8" r="2.2" />
                <circle class="g-node" cx="33" cy="13" r="2.2" />
                <circle class="g-node" cx="30" cy="32" r="2.2" />
              </svg>
            {% when 'brain' %}
              <!-- brain silhouette with signals flowing along a small network -->
              <svg class="glyph glyph-brain" viewBox="0 0 40 40">
                <path
                  class="g-line g-soft"
                  d="M5 21C4 13 10 6 18 6C25 5 33 8 35 15C37 20 35 24 32 25C33 29 29 31 26 29C25 33 21 33 21 29C16 30 10 29 7 26C6 25 5 23 5 21Z"
                />
                <polyline class="g-line g-flow" points="10,20 17,12 26,14 31,20 24,24 15,24 10,20" />
                <line class="g-line g-flow f-b" x1="17" y1="12" x2="24" y2="24" />
                <circle class="g-node" cx="10" cy="20" r="1.8" />
                <circle class="g-node" cx="17" cy="12" r="1.8" />
                <circle class="g-node" cx="26" cy="14" r="1.8" />
                <circle class="g-node" cx="31" cy="20" r="1.8" />
                <circle class="g-node" cx="24" cy="24" r="1.8" />
                <circle class="g-node" cx="15" cy="24" r="1.8" />
              </svg>
            {% when 'learning' %}
              <!-- topological / graph features feeding a classifier -->
              <svg class="glyph glyph-learning" viewBox="0 0 40 40">
                <rect class="g-bar b1" x="7" y="14" width="6" height="20" rx="1.5" />
                <rect class="g-bar b2" x="17" y="8" width="6" height="26" rx="1.5" />
                <rect class="g-bar b3" x="27" y="18" width="6" height="16" rx="1.5" />
                <line class="g-line g-soft" x1="5" y1="34.5" x2="35" y2="34.5" />
              </svg>
          {% endcase %}
        </div>
      {% elsif area.icon %}
        <div class="research-icon"><i class="{{ area.icon }}" aria-hidden="true"></i></div>
      {% endif %}
      <h3 class="research-title">{{ area.title }}</h3>
      <p class="research-text">{{ area.text }}</p>
    </div>
  {% endfor %}
</div>
